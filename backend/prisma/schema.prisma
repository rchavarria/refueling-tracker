// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  brand        String
  model        String
  licensePlate String
  year         Int
  refuelings   Refueling[]
  reminders    Reminder[]
  maintenances Maintenance[]
}

model Refueling {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  date       DateTime
  liters     Float
  totalPrice Float
  mileage    Int
  station    String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  date        DateTime
  description String
  type        String
  mileage     Int
  enabled     Boolean  @default(true)
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Maintenance {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  date        DateTime
  type        String
  description String
  mileage     Int
  cost        Float
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}
